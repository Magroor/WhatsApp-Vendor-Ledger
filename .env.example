# Copy to .env.local (local) or set these in your host (Vercel/Railway).

# Database. Leave EMPTY to use the built-in local database (./.data) for testing.
# For real use set a Postgres URL (Neon / Supabase / Railway):
DATABASE_URL=

# Login password for the whole app (strongly recommended when online).
APP_PASSWORD=

# Report time zone (IANA name). Can also be changed in Settings.
BUSINESS_TIMEZONE=Asia/Karachi

# Secret for the iPhone Share Sheet shortcut (long random text). Keep private.
CAPTURE_TOKEN=

# --- Optional: automatic WhatsApp (Meta Cloud API) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# --- Optional: read photos of bills. FREE option: GEMINI_API_KEY ---
# (get it at https://aistudio.google.com/apikey - no card needed)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Optional: phone notifications (Web Push) ---
# Make the pair once with: npx web-push generate-vapid-keys   (keep the private key secret)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for the push services (mailto: or https:)
VAPID_SUBJECT=mailto:admin@example.com
# Protects /api/cron/daily (long random text). Vercel Cron sends it automatically.
CRON_SECRET=
